<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WeaselSettings.Avalonia.Controls"
             x:Class="WeaselSettings.Avalonia.Controls.RimeColorPicker">
    <Grid ColumnDefinitions="40, *, 50" ColumnSpacing="4">
        <controls:AlphaColorPanel x:Name="PreviewPanel"
                                  Width="40"
                                  Height="26"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />
        <Slider x:Name="AlphaSlider"
                Grid.Column="1"
                Minimum="0"
                Maximum="255"
                VerticalAlignment="Center"
                Margin="0,-10,0,0" />
        <Button x:Name="PickButton"
                Grid.Column="2"
                Width="40"
                Height="26"
                Content="......"
                Padding="0,0"
                VerticalAlignment="Center" />
    </Grid>
</UserControl>
