<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:WeaselSettings.Avalonia.Models"
        x:Class="WeaselSettings.Avalonia.Views.WubiDictWindow"
        Title="五笔用户词库"
        Width="700"
        Height="560"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto, *, Auto" Margin="10" RowSpacing="8">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="按编码过滤：" VerticalAlignment="Center"/>
            <TextBox x:Name="txtFilter" Width="140"/>
            <Button x:Name="btnAdd" Content="添加词条" Padding="12,4"/>
            <Button x:Name="btnDelete" Content="删除词条" Padding="12,4"/>
            <Button x:Name="btnImport" Content="词库导入" Padding="12,4"/>
            <Button x:Name="btnExport" Content="词库导出" Padding="12,4"/>
            <Button x:Name="btnClear" Content="清除词库" Padding="12,4"/>
        </StackPanel>

        <TableView x:Name="dgvList"
                   Grid.Row="1"
                   x:DataType="models:DictItem"
                   BorderBrush="Gray"
                   BorderThickness="1"
                   SelectionMode="Multiple"
                   CanUserResizeColumns="True">
            <TableView.Columns>
                <TableViewColumn Header="编码" Binding="{Binding Code}" Width="1.5*"/>
                <TableViewColumn Header="词条" Binding="{Binding Word}" Width="2*"/>
                <TableViewColumn Header="权重" Binding="{Binding Weight}" Width="0.8*"/>
            </TableView.Columns>
        </TableView>

        <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
            <TextBlock x:Name="lblPageInfo" VerticalAlignment="Center" Text="共 0 条数据"/>
            <Button x:Name="btnOk" Grid.Column="1" Content="确定" MinWidth="80" Padding="12,4"/>
            <Button x:Name="btnCancel" Grid.Column="2" Content="取消" MinWidth="80" Padding="12,4"/>
        </Grid>
    </Grid>
</Window>
