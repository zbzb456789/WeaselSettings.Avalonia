<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WeaselSettings.Avalonia.Views.AddDictWindow"
        Title="自定义编码"
        Width="340"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10">
        <Grid ColumnDefinitions="64, *" ColumnSpacing="8">
            <TextBlock Text="词条：" VerticalAlignment="Center"/>
            <TextBox x:Name="txtWord" Grid.Column="1" MaxLength="32"/>
        </Grid>
        <Grid ColumnDefinitions="64, *" ColumnSpacing="8">
            <TextBlock Text="编码：" VerticalAlignment="Center"/>
            <TextBox x:Name="txtCode" Grid.Column="1" IsEnabled="False" MaxLength="15"/>
        </Grid>
        <Grid ColumnDefinitions="64, *" ColumnSpacing="8">
            <TextBlock Text="权重：" VerticalAlignment="Center"/>
            <TextBox x:Name="txtWeight" Grid.Column="1" IsEnabled="False" Text="10"/>
        </Grid>
        <TextBlock x:Name="lblDupItems" TextWrapping="Wrap" MinHeight="40"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="btnOk" Content="确认" MinWidth="76" Padding="12,4" IsEnabled="False"/>
            <Button x:Name="btnCancel" Content="取消" MinWidth="76" Padding="12,4"/>
        </StackPanel>
    </StackPanel>
</Window>
